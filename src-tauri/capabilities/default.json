{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main ProxyOrbit window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "shell:allow-execute",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default"
  ]
}
