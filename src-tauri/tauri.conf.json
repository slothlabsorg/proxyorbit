{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyOrbit",
  "version": "1.0.0",
  "identifier": "io.slothlabs.proxyorbit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1423",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ProxyOrbit",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRDVFRjc2RDExNTUyClJXUlNGZEYyNzlYT0FKU043VDJLVnJhMG1PUnJZRXhGYVRyTTdYbFVSTEp2SUZtd3VLN1BEWlc0Cg==",
      "endpoints": [
        "https://raw.githubusercontent.com/slothlabsorg/proxyorbit/main/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.38)",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libnotify-bin"
        ]
      }
    }
  }
}
